{
  "name": "dsh-extreme-chat-mode",
  "version": "1.0.0",
  "description": "极限 Chat 模式：DeepSeek Harness 的零注入 Agent 预设，模型只看到用户输入和自己的输出，系统提示词、AGENTS.md、技能目录、运行时上下文、全部工具一律不注入。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "chat",
    "pure-chat",
    "zero-context"
  ],
  "author": "TongenShen",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TongenShen/dsh-extreme-chat-mode.git"
  },
  "homepage": "https://github.com/TongenShen/dsh-extreme-chat-mode#readme",
  "bugs": {
    "url": "https://github.com/TongenShen/dsh-extreme-chat-mode/issues"
  }
}
